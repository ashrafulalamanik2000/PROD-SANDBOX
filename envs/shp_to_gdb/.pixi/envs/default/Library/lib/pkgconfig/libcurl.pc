prefix=C:/sdtools/envs/shp_to_gdb/.pixi/envs/default/Library
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="DICT FILE FTP FTPS GOPHER GOPHERS HTTP HTTPS IMAP IMAPS IPFS IPNS LDAP LDAPS MQTT MQTTS POP3 POP3S RTSP SCP SFTP SMTP SMTPS TELNET TFTP WS WSS"
supported_features="alt-svc AsynchDNS HSTS HTTPS-proxy IPv6 Kerberos Largefile libz PSL SPNEGO SSL SSPI threadsafe Unicode UnixSockets"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with HTTP, FTP, etc.
Version: 8.21.0
Requires: libssh2,zlib,libpsl
Requires.private: libssh2,zlib,libpsl
Libs: -L${libdir} -lcurl -lssh2 C:/sdtools/envs/shp_to_gdb/.pixi/envs/default/Library/lib/z.lib -lwldap32 -lpsl -lbcrypt -ladvapi32 -lcrypt32 -lsecur32 -lws2_32 -liphlpapi
Libs.private: -LC:/sdtools/envs/shp_to_gdb/.pixi/envs/default/Library/bin -lssh2 C:/sdtools/envs/shp_to_gdb/.pixi/envs/default/Library/lib/z.lib -lwldap32 -lpsl -lbcrypt -ladvapi32 -lcrypt32 -lsecur32 -lws2_32 -liphlpapi
Cflags: -I${includedir} -DCURL_STATICLIB
Cflags.private: -DCURL_STATICLIB
