prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenTelemetry Exporter - OStream Metrics Builder
Description: Builder for OStream metrics exporter.
Requires: opentelemetry_exporter_ostream_metrics
Version: 1.27.0

Libs: -L${libdir} -lopentelemetry_exporter_ostream_metrics_builder
Cflags: -I${includedir} 
