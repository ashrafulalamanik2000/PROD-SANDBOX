prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenTelemetry OTLP - gRPC Log Builder
Description: Builder for OTLP gRPC log record exporter.
Requires: opentelemetry_exporter_otlp_grpc_log opentelemetry_exporter_otlp_builder_utils
Version: 1.27.0

Libs: -L${libdir} -lopentelemetry_exporter_otlp_grpc_log_builder
Cflags: -I${includedir} 
