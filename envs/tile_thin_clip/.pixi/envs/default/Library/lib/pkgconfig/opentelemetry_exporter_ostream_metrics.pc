prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenTelemetry Exporter - OStream Metrics
Description: Exports metrics to output stream.
Requires: opentelemetry_metrics
Version: 1.27.0

Libs: -L${libdir} -lopentelemetry_exporter_ostream_metrics
Cflags: -I${includedir} 
