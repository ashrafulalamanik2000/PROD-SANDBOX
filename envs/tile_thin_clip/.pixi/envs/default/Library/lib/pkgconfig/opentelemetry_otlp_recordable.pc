prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenTelemetry OTLP - Recordable
Description: OTLP recordable implementation for spans, metrics, and logs.
Requires: opentelemetry_trace opentelemetry_metrics opentelemetry_logs opentelemetry_resources
Version: 1.27.0

Libs: -L${libdir} -lopentelemetry_otlp_recordable
Cflags: -I${includedir} 
