prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenTelemetry Exporter - OStream Logs Builder
Description: Builder for OStream log record exporter.
Requires: opentelemetry_exporter_ostream_logs
Version: 1.27.0

Libs: -L${libdir} -lopentelemetry_exporter_ostream_logs_builder
Cflags: -I${includedir} 
