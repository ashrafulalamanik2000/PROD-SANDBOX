prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenTelemetry OTLP - Builder Utils
Description: Common utilities for OTLP exporter builders.
Requires: opentelemetry_otlp_recordable
Version: 1.27.0

Libs: -L${libdir} -lopentelemetry_exporter_otlp_builder_utils
Cflags: -I${includedir} 
