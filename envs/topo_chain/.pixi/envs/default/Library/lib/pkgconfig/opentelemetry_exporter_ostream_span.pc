prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenTelemetry Exporter - OStream Span
Description: Exports trace spans to output stream.
Requires: opentelemetry_trace
Version: 1.27.0

Libs: -L${libdir} -lopentelemetry_exporter_ostream_span
Cflags: -I${includedir} 
