prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenTelemetry OTLP - gRPC Metric Builder
Description: Builder for OTLP gRPC metric exporter.
Requires: opentelemetry_exporter_otlp_grpc_metrics opentelemetry_exporter_otlp_builder_utils
Version: 1.27.0

Libs: -L${libdir} -lopentelemetry_exporter_otlp_grpc_metric_builder
Cflags: -I${includedir} 
