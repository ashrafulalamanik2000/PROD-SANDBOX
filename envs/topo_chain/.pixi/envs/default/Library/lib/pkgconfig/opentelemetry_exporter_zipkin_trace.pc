prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenTelemetry Exporter - Zipkin
Description: Exports trace spans in Zipkin format.
Requires: opentelemetry_trace
Version: 1.27.0

Libs: -L${libdir} -lopentelemetry_exporter_zipkin_trace
Cflags: -I${includedir} 
