prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenTelemetry Exporter - In-Memory Span
Description: In-memory span exporter for testing and debugging.
Requires: opentelemetry_trace
Version: 1.27.0

Libs: -L${libdir} -lopentelemetry_exporter_in_memory
Cflags: -I${includedir} 
