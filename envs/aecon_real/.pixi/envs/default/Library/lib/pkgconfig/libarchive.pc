prefix=C:/sdtools/envs/aecon_real/.pixi/envs/default/Library
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libarchive
Description: library that can create and read several streaming archive formats
Version: 3.8.9
Cflags: -I${includedir}
Cflags.private: -DLIBARCHIVE_STATIC
Libs: -L${libdir} -larchive
Libs.private:  -lz -lbz2 -llzma -llz4 -lzstd -lbcrypt -lcrypto -liconv -lcharset -lxml2
Requires.private: 
