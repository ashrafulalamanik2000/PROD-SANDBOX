prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenTelemetry OTLP - HTTP Log Exporter
Description: Exports log records via OTLP HTTP.
Requires: opentelemetry_otlp_recordable opentelemetry_exporter_otlp_http_client
Version: 1.27.0

Libs: -L${libdir} -lopentelemetry_exporter_otlp_http_log
Cflags: -I${includedir} 
