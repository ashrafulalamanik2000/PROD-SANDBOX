prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenTelemetry OTLP - HTTP Log Builder
Description: Builder for OTLP HTTP log record exporter.
Requires: opentelemetry_exporter_otlp_http_log opentelemetry_exporter_otlp_builder_utils
Version: 1.27.0

Libs: -L${libdir} -lopentelemetry_exporter_otlp_http_log_builder
Cflags: -I${includedir} 
