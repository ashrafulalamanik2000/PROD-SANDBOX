prefix=C:/sdtools/envs/aecon_real/.pixi/envs/default/Library
includedir=${prefix}/include
libdir=${prefix}/lib

Name: Pango Win32
Description: Win32 GDI font support for Pango
Version: 1.58.2
Requires: pango
Requires.private: glib-2.0 >=  2.88, gobject-2.0 >=  2.88, gio-2.0 >=  2.88, fribidi >=  1.0.6, harfbuzz >=  11.0.0, fontconfig >=  2.17.0, freetype2, cairo >=  1.18.0, harfbuzz-gobject >=  11.0.0
Libs: -L${libdir} -lpangowin32-1.0
Libs.private: -lgdi32 -ldwrite
Cflags: -I${includedir}/pango-1.0
